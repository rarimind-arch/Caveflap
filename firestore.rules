rules_version = '2';

// Anti-cheat notes (see docs/BUILD_INSTRUCTIONS.md and functions/src for the
// server side of this):
//
// - IAP entitlements (no-ads, VIP, premium pass, starter pack) are never
//   trusted from the client. functions/src/revenuecat.ts verifies each
//   purchase with RevenueCat's webhook and writes the grant to
//   entitlements/{uid}, which this file makes read-only to clients. The
//   client's local save can only *claim* noAds/vip/pass if the matching
//   entitlements/{uid} field says so (see the save-doc rule below) — a
//   modified client cannot just flip those flags in its own write.
// - Casual run currency (crystals/medallions earned by playing) stays
//   client-authoritative, like almost every casual mobile game — round-
//   tripping every pickup to a server would ruin the feel of the game for
//   no real security gain. What IS enforced here is a per-write delta cap,
//   so a modified client calling Firestore directly can't set coins to an
//   arbitrary huge number in one write; functions/src/scores.ts additionally
//   flags accounts whose *cumulative* growth is implausible.
// - Trophies and leaderboard scores are gated by the same delta caps, and
//   functions/src/scores.ts re-validates every scores/{uid} write
//   server-side and clamps or flags anything outside plausible bounds.

function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
function isNum(v) { return v is int || v is float; }

// Generous per-write delta caps: legitimate play earns currency gradually;
// these only need to be looser than any single real run/purchase could
// produce, not tight to normal play.
function withinDelta(before, after, field, maxDelta) {
  return !(field in after) ||
    (!(field in before) ? after[field] <= maxDelta : (isNum(after[field]) && after[field] - (isNum(before[field]) ? before[field] : 0) <= maxDelta));
}

function entitlementOk(uid, after) {
  let ent = existsAfter(/databases/$(database)/documents/entitlements/$(uid))
    ? getAfter(/databases/$(database)/documents/entitlements/$(uid)).data
    : {};
  let noAdsOk = !('noAds' in after) || after.noAds == false || ent.get('noAds', false) == true;
  let vipOk = !('vipUntil' in after) || after.vipUntil <= 0 || ent.get('vipUntil', 0) >= after.vipUntil - 5000;
  let passOk = !('pass' in after) || !('premium' in after.pass) || after.pass.premium == false || ent.get('pass_premium', false) == true;
  let starterOk = !('starterBought' in after) || after.starterBought == false || ent.get('starter', false) == true;
  return noAdsOk && vipOk && passOk && starterOk;
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /data/users/{uid}/save {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && entitlementOk(uid, request.resource.data);
      allow update: if isOwner(uid)
        && entitlementOk(uid, request.resource.data)
        && withinDelta(resource.data, request.resource.data, 'coins', 200000)
        && withinDelta(resource.data, request.resource.data, 'medals', 2000)
        && withinDelta(resource.data, request.resource.data, 'trophies', 1000)
        && withinDelta(resource.data, request.resource.data, 'tokens', 5000)
        && (!('rev' in request.resource.data) || !('rev' in resource.data) || request.resource.data.rev >= resource.data.rev);
      allow delete: if false;
    }

    // Server-only entitlement grants. functions/src/revenuecat.ts writes
    // these with the Admin SDK, which bypasses these rules entirely.
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /players/{uid} {
      allow read: if true; // public player list
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'created', 'lvl', 'batLvl', 'bat', 't'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 16;
      allow delete: if false;
    }

    match /scores/{uid} {
      allow read: if true; // public leaderboard
      allow create, update: if isOwner(uid)
        && withinDelta(resource.data, request.resource.data, 'best', 500)
        && withinDelta(resource.data, request.resource.data, 'trophies', 1000)
        && withinDelta(resource.data, request.resource.data, 'medals', 2000);
      allow delete: if isOwner(uid);
    }
  }
}
